          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="alert" value="Alert Generation&#xa;Created when score is&#xa;MEDIUM or above&#xa;Stored as alert records" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontSize=18;fontStyle=1;fontColor=#dc2626;" vertex="1" parent="1">
          <mxGeometry x="260" y="380" width="260" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="case" value="Case Creation&#xa;Related alerts grouped&#xa;Case opened for review&#xa;Investigation workflow starts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=18;fontStyle=1;fontColor=#16a34a;" vertex="1" parent="1">
          <mxGeometry x="610" y="380" width="260" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="narrative" value="Investigation &amp; Narrative&#xa;Customer profiling&#xa;Pattern analysis&#xa;Narrative is generated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;strokeWidth=2;fontSize=18;fontStyle=1;fontColor=#7c3aed;" vertex="1" parent="1">
