          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="summary" value="How the system behaves&#xa;• Risk score is built from multiple rule hits and weighted by suspicious activity&#xa;• Alerts are created when score reaches medium or higher&#xa;• Cases are created to group related alerts and investigate them as one case&#xa;• Narrative is produced from customer profile, transaction pattern analysis, and investigation findings&#xa;• SAR is escalated only for truly suspicious, critical cases with supporting evidence&#xa;• All outputs are shown in the dashboard for analysts to review and act on" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=2;fontSize=17;fontColor=#334155;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="220" y="620" width="1760" height="220" as="geometry"/>
        </mxCell>
      </root>
