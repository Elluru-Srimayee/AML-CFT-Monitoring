        <mxCell id="title" value="AML / CFT End-to-End Workflow" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="650" y="20" width="900" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="High-level flow from data intake to alerts, cases, narrative, and SAR generation" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=16;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="650" y="60" width="900" height="30" as="geometry"/>
        </mxCell>

