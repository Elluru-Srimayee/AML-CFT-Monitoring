        </mxCell>

        <mxCell id="sar" value="SAR Escalation&#xa;Only high-risk / critical cases&#xa;Multiple rules or sanctions hit&#xa;SAR report is produced" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;strokeWidth=2;fontSize=18;fontStyle=1;fontColor=#a16207;" vertex="1" parent="1">
