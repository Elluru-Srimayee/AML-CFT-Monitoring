        <mxCell id="output" value="Outputs &amp; Dashboards&#xa;Alerts dashboard&#xa;Cases view&#xa;SAR repository" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;fontSize=18;fontStyle=1;fontColor=#2563eb;" vertex="1" parent="1">
          <mxGeometry x="1660" y="380" width="260" height="140" as="geometry"/>
        </mxCell>

